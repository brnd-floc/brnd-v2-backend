# ------------------------------
# Auth hardening
# ------------------------------
# CSV ordered allowlist for QuickAuth JWT domain verification (target final for prod).
QUICKAUTH_ALLOWED_DOMAINS=brnd.land,www.brnd.land,frame.brnd.land
# Legacy transition list used in non-prod defaults or controlled rollback only.
# Do not enable legacy in production unless incident response with change ticket.
# Any production rollback using legacy must include ticket id + UTC expiration date (max 7 days).
QUICKAUTH_ALLOWED_DOMAINS_LEGACY=miniapp.anky.app,brndland.com,miniapp.brndland.com,api.brnd.land
# Optional explicit allowlist for vote-share embed URL verification.
# If unset: production uses final brnd.land URLs; non-prod adds legacy defaults.
BRAND_SHARE_EMBED_URLS=https://brnd.land,https://www.brnd.land,https://frame.brnd.land
# Optional legacy embed URLs for transition windows (primarily non-prod).
# Any production rollback using legacy must include ticket id + UTC expiration date (max 7 days).
BRAND_SHARE_EMBED_URLS_LEGACY=https://rebrnd.lat,https://poiesis.anky.app,https://brnd-v2-backend-production.up.railway.app

# ------------------------------
# Webhooks and debug endpoint controls
# ------------------------------
# Shared secret expected in x-webhook-api-key header.
WEBHOOK_API_KEY=replace-with-strong-secret
# Enable debug/test endpoints outside production only when explicitly needed.
ENABLE_DEBUG_ENDPOINTS=false

# ------------------------------
# Podium metadata generation (milliseconds / retries)
# ------------------------------
# Timeout for image generation before failing request path.
PODIUM_IMAGE_TIMEOUT_MS=6000
# Timeout for each IPFS metadata/image upload attempt.
PODIUM_IPFS_TIMEOUT_MS=8000
# Additional retries for IPFS uploads (total attempts = retries + 1).
PODIUM_IPFS_RETRIES=1

# ------------------------------
# Podium claim rate-limit (in-memory)
# ------------------------------
# Master toggle for claim-signature endpoint throttling.
PODIUM_CLAIM_RATE_LIMIT_ENABLED=true
# Sliding window size in milliseconds.
PODIUM_CLAIM_RATE_LIMIT_WINDOW_MS=60000
# Max requests per window per FID.
PODIUM_CLAIM_RATE_LIMIT_MAX_PER_FID=6
# Max requests per window per IP.
PODIUM_CLAIM_RATE_LIMIT_MAX_PER_IP=20
# Temporary block duration after limit is exceeded (milliseconds).
PODIUM_CLAIM_RATE_LIMIT_BLOCK_MS=120000
